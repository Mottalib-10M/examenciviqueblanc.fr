---
/** Outil intégrable (iframe) : sans navigation, noindex, hors sitemap (astro.config). */
import '../../styles/global.css';
import Tool from '../../components/Tool.astro';
import LicenceNotice from '../../components/LicenceNotice.astro';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
const url = `${SITE_URL}${route('examen-blanc', 'fr')}`;
---
<!doctype html>
<html lang="fr-FR">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Examen civique blanc (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={url} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <Tool tool={{ kind: 'quiz', props: { mention: 'cr', mode: 'exam', mentionSelect: true } }} lang="fr" primary={true} seedKey="embed-examen-civique" />
    <p class="mt-2 text-center text-xs text-navy-600" data-independant>Site indépendant, sans lien avec le ministère de l’Intérieur. <a href={url} target="_blank" rel="noopener" class="underline">{SITE_NAMES.fr}</a></p>
    <LicenceNotice lang="fr" class="mt-2 text-center text-[11px] text-navy-600" />
  </body>
</html>
