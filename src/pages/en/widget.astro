---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/civic-exam/" title="French civic exam mock test" width="100%" height="860" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the French civic exam mock test on your website free" description="Show the free 40-question French civic exam mock test on a charity, school or training website: one frame, no sign-up, no cookies and no fee, with the explanations in English." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the civic exam mock test</h1>
    <p class="mt-3 text-lg text-navy-700">For charities, community centres, language schools and expatriate networks.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: keep the notice and licence attribution under the frame visible, and use it as it is, without warranty. Nothing your visitors answer reaches us and the frame sets no cookie. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/civic-exam/" title="French civic exam mock test" width="100%" height="860" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
